# Required for AI-written compliments. Without it, Dear Lola serves
# compliments from its hand-written fallback bank (handy for local dev/tests).
ANTHROPIC_API_KEY=

# Claude model to use. Defaults to claude-opus-5-5 when unset.
ANTHROPIC_MODEL=claude-opus-5-5

# Effort level: low | medium | high | xhigh | max, or "off" to omit the
# parameter (needed for older models that don't support effort).
# "low" keeps compliments fast; they're short and don't need deep reasoning.
ANTHROPIC_EFFORT=low

# Public URL of the deployment, used for absolute Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
